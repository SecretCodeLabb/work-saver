{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DontCrashNow",
  "version": "1.0.0",
  "identifier": "com.dxnx3d.dontcrashnow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Don't Crash Now!",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "DXNX.3D",
    "copyright": "© 2026 DXNX.3D — MIT License",
    "category": "Utility",
    "shortDescription": "Autoguardado para software de diseño y arte digital",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
